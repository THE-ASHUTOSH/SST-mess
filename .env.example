# Copy this file to `.env.local` and fill in values for LOCAL DEVELOPMENT.
# Production values live in the deploy environment's settings — never in a committed file.
#
# IMPORTANT: point DATABASE_URL at the LOCAL Docker Postgres below, never a shared or production
# server. The seed script (scripts/seed.ts) wipes + repopulates whatever DB this points at.

# --- Clerk (use the DEVELOPMENT instance keys) -------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Database (local Docker Postgres — see docker-compose.yml) ---------------
# Start it with `pnpm db:up`. Credentials come from docker-compose.yml; they are intentionally
# trivial because the server only listens on your own machine.
#   sslmode=disable is REQUIRED — the container has no TLS, and without it pg tries an SSLRequest
#   and the connection fails with "server does not support SSL connections".
DATABASE_URL=postgresql://mess:mess@localhost:5432/mess_dev?sslmode=disable

# --- Meal QR signing key (any strong random string in dev) -------------------
JWT_SECRET_KEY=replace-with-a-long-random-string

# --- App URL (used by Clerk redirects) ---------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Dev seeding ------------------------------------------------------------
# The email the seed promotes to superAdmin. Use YOUR login email so you can explore every role
# (see docs/DEVELOPMENT.md).
DEV_SEED_EMAIL=you@scaler.com
