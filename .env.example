# Copy this file to `.env.local` and fill in values for LOCAL DEVELOPMENT.
# Production values live in Vercel's environment settings — never in a committed file.
#
# IMPORTANT: point DATABASE_URL at your own Neon **dev branch**, never the production branch.
# The seed script (scripts/seed.ts) wipes + repopulates whatever DB this points at.

# --- Clerk (use the DEVELOPMENT instance keys) -------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Database (Neon dev branch connection string) ----------------------------
DATABASE_URL=postgresql://<user>:<password>@<dev-branch-host>/<db>?sslmode=require

# --- Meal QR signing key (any strong random string in dev) -------------------
JWT_SECRET_KEY=replace-with-a-long-random-string

# --- App URL (used by Clerk redirects) ---------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Dev seeding ------------------------------------------------------------
# The email the seed promotes to superAdmin AND maps to a demo vendor. Use YOUR
# login email so you can explore every role (see docs/DEVELOPMENT.md).
DEV_SEED_EMAIL=you@scaler.com
